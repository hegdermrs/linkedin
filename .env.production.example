# Copy to .env on your VPS: cp .env.production.example .env

# Domains (point both A records to your VPS IP)
APP_DOMAIN=outreach.yourdomain.com
API_DOMAIN=api.yourdomain.com
ACME_EMAIL=you@yourdomain.com

# Public URLs (must match domains, https after Caddy starts)
WEB_URL=https://outreach.yourdomain.com
API_URL=https://api.yourdomain.com

# Database (used by compose — do not use weak passwords)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=linkedin_agent

# App secrets — CHANGE ALL OF THESE
SESSION_ENCRYPTION_KEY=generate-32-plus-character-random-string
AGENCY_ADMIN_EMAIL=admin@yourdomain.com
AGENCY_ADMIN_PASSWORD=generate-a-strong-password
DEEPSEEK_API_KEY=

# Optional
OPENAI_API_KEY=

# Optional
CALENDLY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
