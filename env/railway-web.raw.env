# Paste into Railway → web service → Variables → Raw Editor
#
# Use Railway "Reference" when adding API_URL (do not type ${{...}} by hand).
# Service name must match your api service (here: api).

NODE_ENV=production

API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}

# Strongly recommended if you see "Decoding failed" or 502 — api public https URL:
# API_FALLBACK_URL=https://CHANGE_ME-api.up.railway.app

# Do NOT set NEXT_PUBLIC_API_URL (breaks Chrome login cookies).
