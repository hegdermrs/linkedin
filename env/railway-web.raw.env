# Paste into Railway → web service → Variables → Raw Editor
#
# Recommended: proxy API through the same domain (no CORS / NetworkError).
# In Railway UI use "Reference" for api.PORT when adding API_URL.

NODE_ENV=production

API_URL=http://api.railway.internal:${{api.PORT}}

# Optional — only if you skip API_URL and call api directly from the browser:
# NEXT_PUBLIC_API_URL=https://CHANGE_ME-api.up.railway.app
